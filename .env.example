# ─────────────────────────────────────────────────────────────
# Noma · variables de entorno (copiar a .env.local y completar)
# ─────────────────────────────────────────────────────────────

# Supabase ----------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Solo servidor (scripts/seed, operaciones admin). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Base de datos (Drizzle) -------------------------------------
# DEV LOCAL (recomendado): Postgres local, no toca datos reales. `createdb noma`.
#   Baseline: `npm run db:deploy` (migraciones) + `npm run db:seed`.
DATABASE_URL="postgresql://postgres@localhost:5432/noma"
# PROD (Vercel): usar el POOLER de Supabase (puerto 6543):
#   postgresql://postgres.PROJECT:[PASSWORD]@aws-...pooler.supabase.com:6543/postgres
# MIGRACIONES (GitHub Action): usar la CONEXIÓN DIRECTA (puerto 5432) como secreto
#   DATABASE_URL en GitHub → Settings → Secrets and variables → Actions.

# Auth (Google Workspace SSO) ---------------------------------
# Se configura el provider Google en Supabase Auth. Opcional: restringir dominio.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN="studionomade.cl"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Asana (opcional; lectura operacional y traspaso) ------------
# Token central del estudio. Nunca usar una variable NEXT_PUBLIC_*.
ASANA_ACCESS_TOKEN="your-asana-personal-access-token"
# Contenedor donde Noma crea tareas al hacer el traspaso.
ASANA_PROJECT_GID="your-asana-project-gid"
# Opcional: permite listar proyectos del workspace mediante la API.
ASANA_WORKSPACE_GID="your-asana-workspace-gid"

# Conexiones OAuth personales (Asana / Slack) -----------------
# Base64 de 32 bytes: `openssl rand -base64 32`.
# Debe ser estable entre deploys; rotarla invalida los tokens ya cifrados.
NOMA_TOKEN_ENCRYPTION_KEY="base64-32-byte-key"
ASANA_OAUTH_CLIENT_ID="your-asana-oauth-client-id"
ASANA_OAUTH_CLIENT_SECRET="your-asana-oauth-client-secret"
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"

# Roles -------------------------------------------------------
# Superadmin: acceso total. Solo Dirección.
NOMA_SUPERADMIN_EMAILS="sebastian@studionomade.cl,ana@studionomade.cl"
# Comercial/Finanzas: opera Finanzas y puede editar el catálogo.
NOMA_COMERCIAL_EMAILS="sales@studionomade.cl"
# Legal/Compliance: SLA y documentación legal.
NOMA_LEGAL_EMAILS="legal@studionomade.cl"
# Personas/Onboarding. legal@ puede actuar como alias.
NOMA_PEOPLE_EMAILS="people@studionomade.cl,legal@studionomade.cl"

# Bypass de auth SOLO dev local (opcional) --------------------
# Si se define y NODE_ENV!=production, entra como este correo sin Google/Supabase.
# NUNCA definir en producción. Comentar para exigir login real en local.
# NOMA_DEV_AUTH_EMAIL="sebastian@studionomade.cl"

# Cobranza (CFO) — remitente de los correos de cobranza --------
# Casilla desde la que salen los correos. Debe haber iniciado sesión en Noma una
# vez (para tener su refresh token de Gmail). Requiere GOOGLE_CLIENT_ID/SECRET.
NOMA_COBRANZA_FROM="sales@studionomade.cl"

# Conversor de moneda (UF / dólar observado) ------------------
# Fuente por defecto: https://mindicador.cl (Banco Central de Chile, sin API key).
MINDICADOR_API_URL="https://mindicador.cl/api"

# IA central del estudio (opcional; nunca per-user) ------------
# Las suscripciones personales ChatGPT/Gemini no entregan cuota API.
OPENAI_API_KEY="your-openai-api-key"
# Opcional: modelo del agente de WhatsApp. Default server-side: gpt-5.6-sol.
OPENAI_MODEL="gpt-5.6-sol"
GEMINI_API_KEY="your-gemini-api-key"

# WhatsApp Business Cloud API (Meta) --------------------------
# Solo servidor. El verify token lo define el estudio; app secret y access
# token se obtienen desde la app de Meta. Nunca usar variables NEXT_PUBLIC_*.
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"
WHATSAPP_APP_SECRET="your-meta-app-secret"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-system-user-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
